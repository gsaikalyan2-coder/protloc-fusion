# ProtLoc Fusion — environment template
#
# Copy to .env and fill only the block belonging to the phase you are running:
#
#     cp .env.example .env
#
# .env is git-ignored and never committed. Every secret here reads
# ENTER_YOUR_VALUE_HERE; a real value in this file is a leak, not a convenience.
# Non-secret defaults are filled in, because a default that is safe to publish is
# safe to publish.
#
# backend/protloc/config/settings.py reads only the Phase 1 block today. A
# variable named here but not yet read belongs to a phase that has not run —
# settings ignores it rather than rejecting it, so this file stays valid
# throughout.
#
# CLAUDE.md holds the table of where each value comes from and which phase fills
# it. Keep the two in step: a variable added there is added here in the same
# commit.

# ── Phase 1: scaffold ────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Phase 3: data ────────────────────────────────────────────────────────────
DATA_ROOT=./data
# A GUARD, not the record. The release is read from UniProt's reldate.txt and
# recorded in data/manifests/dataset_manifest.json (authoritative). If set, it
# must equal the manifest; scripts/download_data.py refuses a mismatch.
UNIPROT_RELEASE=ENTER_YOUR_VALUE_HERE
# Measured in Phase 3 by scripts/validate_sequences.py --freeze and recorded in
# the manifest and data/manifests/DATASET_CARD.md. Copy that value here.
MAX_SEQUENCE_LENGTH=ENTER_YOUR_VALUE_HERE

# ── Phase 5: features ────────────────────────────────────────────────────────
EMBED_CACHE=./data/embeddings
ESM_CHECKPOINT=facebook/esm2_t30_150M_UR50D
# The commit hash of the revision you pull. The embedding cache key includes it:
# a checkpoint name alone does not identify the weights that produced a vector.
ESM_REVISION=a695f6045e2e32885fa60af20c13cb35398ce30c
# huggingface.co -> Settings -> Access Tokens. Read scope only until Phase 16.
HF_TOKEN=ENTER_YOUR_VALUE_HERE

# ── Phase 6: experiment tracking ─────────────────────────────────────────────
# W&B is a viewer. The run manifest is authoritative (ADR-0004).
WANDB_API_KEY=ENTER_YOUR_VALUE_HERE
WANDB_PROJECT=protloc-fusion

# ── Phase 11: serving ────────────────────────────────────────────────────────
MODEL_REGISTRY=./registry
MODEL_VERSION=1.0.0
# ADR-0001. 'queue' is the only supported mode; every prediction is a job.
MODEL_SERVING_MODE=queue
# Chosen from measured throughput in Phase 13. Start conservative.
MAX_BATCH_SEQUENCES=ENTER_YOUR_VALUE_HERE
# Size-one fast path. A convenience, never a contract: clients handle 202.
INLINE_RESULT_WINDOW_SECONDS=2
# Result URLs return 410 Gone past this, never a silent empty result.
JOB_RETENTION_HOURS=ENTER_YOUR_VALUE_HERE

# ── Phase 10: evidence ───────────────────────────────────────────────────────
# ADR-0003: local snapshots only. No network call on the request path.
EVIDENCE_ROOT=./data/evidence
SWISSPROT_DB_PATH=./data/evidence/swissprot_mmseqs
GOA_STORE_PATH=./data/evidence/goa.db
# The GAF release string on the day you snapshot UniProt-GOA.
GOA_RELEASE=ENTER_YOUR_VALUE_HERE
EVIDENCE_TIMEOUT_SECONDS=5
EVIDENCE_TOP_K=5

# ── Phase 16: hosting ────────────────────────────────────────────────────────
# ADR-0005. Spaces disk is non-persistent; artifacts are pulled at start.
HF_MODEL_REPO=sk8069/protloc-fusion
HF_EVIDENCE_REPO=sk8069/protloc-fusion-evidence
HF_CHECKPOINT_REPO=sk8069/protloc-fusion-checkpoints
HF_DATA_REPO=sk8069/protloc-fusion-data
ARTIFACT_CACHE_DIR=/data/artifacts
# The frontend Static Space URL. CORS is restricted to it; '*' is rejected.
FRONTEND_ORIGIN=ENTER_YOUR_VALUE_HERE

# ── Phase 15: observability + security ───────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=ENTER_YOUR_VALUE_HERE
# Both set from the Phase 13 load numbers.
RATE_LIMIT_PER_MINUTE=ENTER_YOUR_VALUE_HERE
MAX_UPLOAD_BYTES=ENTER_YOUR_VALUE_HERE

# ── Phase 16: deploy ─────────────────────────────────────────────────────────
SENTRY_DSN=ENTER_YOUR_VALUE_HERE
